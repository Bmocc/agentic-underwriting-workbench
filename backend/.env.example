# Copy this file to .env and fill in your values

# Required for property search
RapidAPI_Key=your_rapidapi_key_here

# Required for AI agent features
OPENAI_API_KEY=your_openai_api_key_here

# Optional — static API key the frontend must send as X-API-Key header
# Leave blank to disable auth (local development)
UNDERWRITER_API_KEY=

# Optional — max RapidAPI calls per minute per IP (default: 10)
RAPIDAPI_RATE_LIMIT=10

# Optional — override AI model (default: gpt-4o-mini)
UNDERWRITER_AGENT_MODEL=gpt-4o-mini
